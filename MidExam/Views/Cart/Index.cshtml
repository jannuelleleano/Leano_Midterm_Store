@model IEnumerable<MidExam.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page">

    <div class="cart-header">

        <div>

            <h1>
                Shopping Cart
            </h1>

            <p>
                Review your selected motorcycle parts.
            </p>

        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="continue-shopping">
            ← Continue Shopping
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-cart">

            <div class="empty-cart-icon">
                🛒
            </div>

            <h2>
                Your Cart is Empty
            </h2>

            <p>
                You haven't added any products yet.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="shop-now-btn">
                Shop Products
            </a>

        </div>
    }
    else
    {
        <div class="cart-layout">

            <div class="cart-items">

                @foreach (var item in Model)
                {
                    <div class="cart-item">

                        <div class="cart-item-number">
                            #@item.ProductId.ToString("00")
                        </div>


                        <div class="cart-item-info">

                            <h3>
                                @item.ProductName
                            </h3>

                            <span>
                                Motorcycle Part
                            </span>

                        </div>


                        <div class="cart-item-price">

                            <small>
                                PRICE
                            </small>

                            <strong>
                                ₱@item.Price.ToString("N2")
                            </strong>

                        </div>


                        <form asp-action="UpdateQuantity"
                              method="post"
                              class="quantity-form">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <label>
                                Qty
                            </label>

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="quantity-input" />

                            <button type="submit"
                                    class="update-btn">
                                Update
                            </button>

                        </form>


                        <form asp-action="Remove"
                              method="post"
                              class="remove-form">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="remove-btn">
                                ×
                            </button>

                        </form>

                    </div>
                }

            </div>


            <!-- SUMMARY -->

            <div class="cart-summary">

                <div class="summary-title">
                    Cart Summary
                </div>

                <div class="summary-line">

                    <span>
                        Items
                    </span>

                    <strong>
                        @Model.Sum(x => x.Quantity)
                    </strong>

                </div>

                <div class="summary-line">

                    <span>
                        Products
                    </span>

                    <strong>
                        @Model.Count()
                    </strong>

                </div>

                <div class="summary-divider"></div>

                <div class="summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        ₱@Model.Sum(x => x.Price * x.Quantity).ToString("N2")
                    </strong>

                </div>

            </div>

        </div>
    }

</div>