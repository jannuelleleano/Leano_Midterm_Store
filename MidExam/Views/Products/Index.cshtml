@model IEnumerable<MidExam.Models.Product>

@{
    ViewData["Title"] = "Products";
    var search = ViewData["Search"]?.ToString();
}

<div class="racing-page">

    <!-- SHOP HEADER -->
    <div class="shop-header">

        <div class="shop-brand">
            <div class="brand-line"></div>

            <div>
                <div class="shop-name">
                    TEAM AGNAT YOLAC
                </div>

                <div class="shop-subtitle">
                    RACING • MOTORCYCLE PARTS • PERFORMANCE
                </div>
            </div>
        </div>

        <a asp-action="Create"
           class="btn add-product-btn">
            + Add Product
        </a>

    </div>


    <!-- SEARCH -->
    <div class="search-section">

        <form asp-action="Index"
              method="get"
              class="search-form">

            <div class="search-wrapper">

                <span class="search-symbol">
                    🔍
                </span>

                <input type="text"
                       name="search"
                       value="@search"
                       class="search-input"
                       placeholder="Search motorcycle parts..." />

            </div>

            <button type="submit"
                    class="btn search-btn">
                SEARCH
            </button>

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index"
                   class="clear-link">
                    Clear
                </a>
            }

        </form>

    </div>


    <!-- SEARCH RESULT -->
    @if (!string.IsNullOrWhiteSpace(search))
    {
        <div class="search-result">

            <span>
                Search results for:
                <strong>"@search"</strong>
            </span>

            <span>
                @Model.Count() product(s) found
            </span>

        </div>
    }


    <!-- PRODUCTS -->
    @if (!Model.Any())
    {
        <div class="empty-products">

            <div class="empty-icon">
                🏍️
            </div>

            <h3>
                No parts found
            </h3>

            <p>
                Try searching for another motorcycle part or category.
            </p>

            <a asp-action="Index"
               class="btn search-btn">
                VIEW ALL PARTS
            </a>

        </div>
    }
    else
    {
        <div class="products-list">

            @foreach (var product in Model)
            {
                <div class="product-card">

                    <!-- RACING STRIPE -->
                    <div class="racing-stripe"></div>


                    <!-- PRODUCT BODY -->
                    <div class="product-body">

                        <div class="product-top">

                            <div>

                                <h2 class="product-name">
                                    @product.Name
                                </h2>

                                <span class="product-category">
                                    @product.Category
                                </span>

                            </div>

                            <div class="product-number">
                                #@product.Id.ToString("00")
                            </div>

                        </div>


                        <p class="product-description">
                            @product.Description
                        </p>


                        <div class="product-bottom">

                            <div class="product-price">
                                ₱@product.Price.ToString("N2")
                            </div>

                            <div class="performance-label">
                                RACING PART
                            </div>

                        </div>

                    </div>


                    <!-- PRODUCT ACTIONS -->
                    <div class="product-footer">

                        <form asp-action="AddToCart"
                              method="post"
                              class="cart-form">

                            <input type="hidden"
                                   name="id"
                                   value="@product.Id" />

                            <button type="submit"
                                    class="btn add-cart-btn">
                                🛒 ADD TO CART
                            </button>

                        </form>


                        <a asp-action="Edit"
                           asp-route-id="@product.Id"
                           class="btn edit-btn">
                            EDIT
                        </a>


                        <a asp-action="Delete"
                           asp-route-id="@product.Id"
                           class="btn delete-btn">
                            DELETE
                        </a>

                    </div>

                </div>
            }

        </div>
    }


    <!-- CART -->
    <div class="cart-section">

        <a asp-controller="Cart"
           asp-action="Index"
           class="cart-link">
            🛒 VIEW SHOPPING CART
        </a>

    </div>

</div>