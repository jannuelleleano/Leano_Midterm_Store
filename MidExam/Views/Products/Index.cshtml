@model IEnumerable<MidExam.Models.Product>

@{
    ViewData["Title"] = "Products";
    var search = ViewData["Search"]?.ToString();
}

<div class="products-page">

    <div class="products-header">

        <h1>
            Team Agnat Yolac Racing Products
        </h1>

        <a asp-action="Create"
           class="add-product-button">
            + Add Product
        </a>

    </div>


    <!-- SEARCH -->

    <div class="search-section">

        <form asp-action="Index"
              method="get"
              class="search-form">

            <input type="text"
                   name="search"
                   value="@search"
                   class="search-input"
                   placeholder="Search product name..." />

            <button type="submit"
                    class="search-button">
                Search
            </button>

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index"
                   class="clear-link">
                    Clear
                </a>
            }

        </form>

    </div>


    <!-- SEARCH RESULT -->

    @if (!string.IsNullOrWhiteSpace(search))
    {
        <div class="search-result">

            Search results for:
            <strong>
                "@search"
            </strong>

            —
            @Model.Count() product(s) found

        </div>
    }


    <!-- PRODUCTS -->

    @if (!Model.Any())
    {
        <div class="empty-products">

            <div class="empty-icon">
                🛒
            </div>

            <h3>
                No products found
            </h3>

            <p>
                Try searching for another product.
            </p>

            <a asp-action="Index"
               class="shop-now-btn">
                View All Products
            </a>

        </div>
    }
    else
    {
        <div class="products-list">

            @foreach (var product in Model)
            {
                <div class="product-card">

                    <!-- PRODUCT INFORMATION -->

                    <div class="product-body">

                        <div class="product-top">

                            <h2 class="product-name">
                                @product.Name
                            </h2>

                            <span class="product-category">
                                @product.Category
                            </span>

                        </div>


                        <p class="product-description">
                            @product.Description
                        </p>


                        <div class="product-bottom">

                            <div class="product-price">
                                ₱@product.Price.ToString("N2")
                            </div>

                        </div>

                    </div>


                    <!-- BUTTONS -->

                    <div class="product-footer">

                        <!-- ADD TO CART -->

                        <form asp-action="AddToCart"
                              method="post"
                              class="cart-form">

                            <input type="hidden"
                                   name="id"
                                   value="@product.Id" />

                            <button type="submit"
                                    class="add-cart-btn">
                                Add to Cart
                            </button>

                        </form>


                        <!-- EDIT -->

                        <a asp-action="Edit"
                           asp-route-id="@product.Id"
                           class="edit-btn">
                            Edit
                        </a>


                        <!-- DELETE -->

                        <a asp-action="Delete"
                           asp-route-id="@product.Id"
                           class="delete-btn">
                            Delete
                        </a>

                    </div>

                </div>
            }

        </div>
    }


    <!-- CART -->

    <div class="cart-section">

        <a asp-controller="Cart"
           asp-action="Index"
           class="cart-link">
            View Shopping Cart →
        </a>

    </div>

</div>